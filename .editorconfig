[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# == Global Settings

# === Documentation

[*.{adoc,ad}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 2

# === Configuration

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# == Project Configs

[*.{html,css}]
indent_style = space
indent_size = 4

[wrangler.jsonc]
indent_style = space
indent_size = 2
